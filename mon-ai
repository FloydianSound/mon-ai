def load_state():
    global TOTAL_WH, TOTAL_COST, TOTAL_CO2
    try:
        if os.path.exists(STATE_FILE):
            with open(STATE_FILE, "r") as f:
                data = json.load(f)
                TOTAL_WH = data.get("total_wh", 0.0); TOTAL_COST = data.get("total_cost", 0.0); TOTAL_CO2 = data.get("total_co2", 0.0)
    except: pass

def save_state():
    try:
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        with open(STATE_FILE, "w") as f:
            json.dump({"total_wh": TOTAL_WH, "total_cost": TOTAL_COST, "total_co2": TOTAL_CO2}, f)
    except: pass

def get_psu_efficiency(dc_watts):
    load_p = (dc_watts / 1500.0) * 100
    if load_p < 2: return 0.70
    if load_p < 5: return 0.85
    if load_p < 10: return 0.91
    if load_p < 20: return 0.94
    if load_p < 50: return 0.96
    return 0.94

def get_fan_power(cpu_temp):
    try:
        t = float(cpu_temp)
        pwm = 0.2 if t <= 40 else (1.0 if t >= 75 else 0.2 + (0.8 * (t - 40) / 35.0))
        return 5.0 + (49.0 * (pwm ** 2.5))
    except: return 15.0

def get_airflow_stats(cpu_temp):
    try:
        t = float(cpu_temp)
        pwm = 0.2 if t <= 40 else (1.0 if t >= 75 else 0.2 + (0.8 * (t - 40) / 35.0))
        in_cfm = (2 * 143.2) * pwm
        ex_cfm = (223.4 * pwm) + (2 * 82.7 * (pwm * 0.5))
        bal = in_cfm - ex_cfm
        state = f"{C_GREEN}POS{C_RESET}" if bal > 5 else (f"{C_RED}NEG{C_RESET}" if bal < -5 else f"{C_CYAN}NEU{C_RESET}")
        gauge_w = 8; val = max(-100, min(100, bal)); pos = int((val + 100) / 200 * gauge_w)
        gauge = f"[{C_CYAN}{'·' * pos}{C_ORANGE}⟛{C_RESET}{C_CYAN}{'·' * (gauge_w - pos)}{C_RESET}]"
        return {"in": in_cfm, "ex": ex_cfm, "state": state, "gauge": gauge}
    except: return None

def reset_cursor(): print("\033[H\033[?25l", end="")
def show_cursor(): print("\033[?25h", end="")
def is_key_pressed(): return select.select([sys.stdin], [], [], 0) == ([sys.stdin], [], [])
def is_port_open(port):
    if port <= 0: return False
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.05)
        try:
            if s.connect_ex(('127.0.0.1', port)) == 0:
                if port == 7860: # Send minimal valid HTTP for SD-WebUI to silence warnings
                    s.sendall(b"HEAD / HTTP/1.1\r\nHost: 127.0.0.1\r\n\r\n")
                return True
            return False
        except: return False

def set_status(msg):
    global LAST_CMD, CMD_EXPIRE
    clean_msg = re.sub(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])', '', str(msg))
    LAST_CMD = clean_msg.replace('\n', ' ').strip(); CMD_EXPIRE = time.time() + 5.0

def run_captured(cmd_list):
    try:
        res = subprocess.run(cmd_list, capture_output=True, text=True, timeout=10)
        out = res.stdout.strip() or res.stderr.strip()
        if out: set_status(out.splitlines()[-1])
        else: set_status("COMMAND SUCCESSFUL")
    except Exception as e: set_status(f"ERROR: {str(e)}")

def get_temp_color(temp_str):
    try:
        t = float(re.findall(r"([0-9.]+)", str(temp_str))[0])
        if t < 45: return C_BLUE
        if t < 65: return C_GREEN
        if t < 80: return C_YELLOW
        return C_RED
    except: return C_WHITE

def toggle_service(service_name, label):
    is_on = SERVICE_STATES[service_name]["active"]; action = "stop" if is_on else "start"
    set_status(f"{'STOPPING' if is_on else 'STARTING'} {label.upper()}...")
    run_captured(["systemctl", "--user", action, service_name])

def get_cpu_info():
    global LAST_CPU_E, LAST_CPU_T, CPU_HW_PATHS
    try:
        util = psutil.cpu_percent(interval=None)
        ghz = psutil.cpu_freq().current / 1000.0 if psutil.cpu_freq() else 0.0
        watts = 0.0
        if CPU_HW_PATHS["pwr"]:
            try:
                curr_e = int(open(CPU_HW_PATHS["pwr"]).read()); curr_t = time.time()
                if LAST_CPU_E > 0: watts = (curr_e - LAST_CPU_E) / 1000000 / (curr_t - LAST_CPU_T)
                LAST_CPU_E = curr_e; LAST_CPU_T = curr_t
            except: pass
        p_disp = f"{watts:.1f}W" if watts > 0 else "N/A"
        temp = int(open(CPU_HW_PATHS["tmp"]).read()) / 1000 if CPU_HW_PATHS["tmp"] else "N/A"
        reason = ""; is_alert = False; is_active = util > 10.0
        try:
            t_v = float(temp)
            if t_v >= 98: reason = "THERMAL"; is_alert = True
            elif watts >= 350: reason = "POWER"; is_alert = True
            elif not is_active and util < 5.0: reason = "IDLE"; is_alert = False
        except: pass
        return {"util": util, "temp": temp, "ghz": ghz, "boost": "OC!" if ghz > 5.6 else ("BST" if ghz > 3.2 else "REG"), "boost_color": C_PURPLE if ghz > 5.6 else (C_CYAN if ghz > 3.2 else C_ORANGE), "reason": reason, "is_alert": is_alert, "pwr": p_disp, "bus": "DMI 4.0 x8"}
    except: return None

def get_zram_info():
    try:
        out = subprocess.check_output("zramctl --raw --noheadings -o DISKSIZE,DATA,COMPR,TOTAL", shell=True).decode().split()
        if len(out) >= 4:
            def to_mb(s):
                u = {"G": 1024, "M": 1, "K": 1/1024, "B": 1/(1024*1024)}
                return float(s[:-1]) * u[s[-1].upper()] if s[-1].upper() in u else float(s)
            disk = to_mb(out[0]); logical = to_mb(out[1]); physical = to_mb(out[3])
            return {"used": logical, "total": disk, "percent": (logical/disk)*100 if disk else 0, "phys": physical}
    except: pass
    return None

def update_energy(cpu_pwr, gpu_pwr, cpu_temp):
    global SESSION_WH, SESSION_COST, LAST_UPDATE, PEAK_W, TOTAL_WH, TOTAL_COST, TOTAL_CO2, PREV_W, PREV_M_PEAK, PEAK_HISTORY, DISP_WATTS
    now = time.time(); dt = now - LAST_UPDATE; LAST_UPDATE = now
    try: c_w = float(str(cpu_pwr).replace("W", ""))
    except: c_w = 0.0
    internal_dc_w = c_w + (gpu_pwr or 0) + 70.0 + get_fan_power(cpu_temp)
    total_w = (internal_dc_w / get_psu_efficiency(internal_dc_w)) + DISP_WATTS
    PEAK_HISTORY.append((now, total_w)); PEAK_HISTORY = [x for x in PEAK_HISTORY if now - x[0] <= 60]
    m_peak = max([x[1] for x in PEAK_HISTORY]) if PEAK_HISTORY else total_w
    p_t = "↑" if m_peak > PREV_M_PEAK + 0.1 else ("↓" if m_peak < PREV_M_PEAK - 0.1 else " ")
    w_t = "↑" if total_w > PREV_W + 2 else ("↓" if total_w < PREV_W - 2 else " ")
    PREV_M_PEAK = m_peak; PREV_W = total_w; PEAK_W = max(PEAK_W, total_w)
    wh = (total_w * dt) / 3600; SESSION_WH += wh; TOTAL_WH += wh
    elapsed = (now - START_TIME) / 3600
    if elapsed > 0.001:
        avg_w = SESSION_WH / elapsed; d_kwh = (avg_w * 24) / 1000
    else: d_kwh = 0.0
    tier = 1 if d_kwh <= 40.0 else 2
    rate = 0.07065 if tier == 1 else 0.11142
    cost = (wh / 1000) * rate; SESSION_COST += cost; TOTAL_COST += cost
    TOTAL_CO2 += (wh / 1000) * 475.0
    if int(now) % 30 == 0: save_state()
    d_cost = d_kwh * rate; m_cost = d_kwh * 30 * rate
    burn = (total_w / 1000.0) * rate; next_d = (1.0 - (SESSION_COST % 1.0)) / burn if burn > 0 else 0
    return {"total_w": total_w, "peak_w": PEAK_W, "m_peak": m_peak, "m_cost": m_cost, "d_cost": d_cost, "next_d": next_d, "w_t": w_t, "p_t": p_t, "rate": rate, "tier": tier, "d_kwh": d_kwh}

def buf_move(y, x): return f"\033[{y};{x}H"
def draw_frame(y, x, w, h, title=""):
    out = buf_move(y, x) + f"{C_CYAN}┌{'─' * (w-2)}┐{C_RESET}"
    for i in range(1, h-1): out += buf_move(y+i, x) + f"\033[K"
    out += buf_move(y+h-1, x) + f"{C_CYAN}└{'─' * (w-2)}┘{C_RESET}"
    if title: out += buf_move(y, x+2) + f"{C_BOLD}{C_CYAN} {title} {C_RESET}"
    return out

def draw_bar(y, x, w, percent, color, label, suffix="", boost="", b_color=C_CYAN):
    bar_w = w - 18
    filled = max(0, min(bar_w, int(percent / 100 * bar_w)))
    bar = f"{color}{'█' * filled}{C_RESET}{C_GREY}{'░' * (bar_w - filled)}{C_RESET}"
    return buf_move(y, x) + f"\033[K{label:5} {bar} {C_BOLD}{suffix:>6}{C_RESET} {C_BOLD}{b_color}{boost:>3}{C_RESET}"

def draw_stacked_bar(y, x, w, segments, label, suffix=""):
    bar_w = w - 18
    fills = []; total_fill = 0
    for p, _ in segments:
        f = int(max(0, p) / 100 * bar_w); fills.append(f); total_fill += f
    while total_fill > bar_w:
        idx = fills.index(max(fills)); fills[idx] -= 1; total_fill -= 1
    bar = "".join([f"{segments[i][1]}{'█' * f}{C_RESET}" for i, f in enumerate(fills) if f > 0])
    bar += f"{C_GREY}{'░' * (bar_w - total_fill)}{C_RESET}"
    return buf_move(y, x) + f"\033[K{label:5} {bar} {C_BOLD}{suffix:>6}{C_RESET}    "

