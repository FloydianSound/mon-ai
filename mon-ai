def display_worker():
    global IS_RUNNING, DISP_WATTS, DISP_INFO
    while IS_RUNNING:
        hdr_active = False; vrr_active = False; curr_hz = 60
        b1 = 100; b2 = 100
        try:
            # 1. Update Software State (Fast)
            ks_out = subprocess.check_output("kscreen-doctor -j", shell=True).decode()
            ks_data = json.loads(ks_out)
            for output in ks_data.get('outputs', []):
                if output.get('name') == 'DP-1': # LG 38"
                    hdr_active = output.get('hdr', False)
                    vrr_active = output.get('vrrPolicy', 0) > 0
                    mode_id = str(output.get('currentModeId'))
                    for mode in output.get('modes', []):
                        if str(mode.get('id')) == mode_id:
                            curr_hz = int(float(mode.get('refreshRate', 60)))
        except: pass

        try:
            # 2. Update Hardware Brightness (Slower/Unreliable)
            l_out = subprocess.check_output("ddcutil getvcp 10 --display 1 --timeout 1 2>/dev/null", shell=True).decode()
            b2 = int(re.search(r'current value =\s+(\d+)', l_out).group(1))
            try:
                a_out = subprocess.check_output("ddcutil getvcp 10 --display 2 --timeout 1 2>/dev/null", shell=True).decode()
                b1 = int(re.search(r'current value =\s+(\d+)', a_out).group(1))
            except: b1 = 100
        except: pass

        # 3. Calculate Watts & Update Global State
        h_mult = 1.3 if hdr_active else 1.0
        vrr_tax = 5.0 if vrr_active or curr_hz > 60 else 0.0
        w1 = 10.0 + (55.0 * (b1 / 100.0))
        w2 = 10.0 + (70.0 * (b2 / 100.0) * h_mult) + vrr_tax
        DISP_WATTS = w1 + w2
        DISP_INFO = {"d1": b1, "d2": b2, "hdr": hdr_active, "vrr": vrr_active, "hz": curr_hz}
        
        for _ in range(10): # Update every 10 seconds
            if not IS_RUNNING: break
            time.sleep(1)

def disk_io_worker():
    global IS_RUNNING, IO_SPEEDS, PREV_DISK_IO
    while IS_RUNNING:
        try:
            curr_io = psutil.disk_io_counters(perdisk=True).get('nvme0n1')
            now = time.time()
            if curr_io and PREV_DISK_IO:
                dt = now - IO_SPEEDS["last_t"]
                if dt > 0:
                    IO_SPEEDS["read"] = (curr_io.read_bytes - PREV_DISK_IO.read_bytes) / 1048576 / dt
                    IO_SPEEDS["write"] = (curr_io.write_bytes - PREV_DISK_IO.write_bytes) / 1048576 / dt
            PREV_DISK_IO = curr_io; IO_SPEEDS["last_t"] = now
        except: pass
        time.sleep(1.0)

def service_worker():
    global IS_RUNNING, SERVICE_STATES
    while IS_RUNNING:
        for svc, state in SERVICE_STATES.items():
            try:
                cmd = ["systemctl", "--user", "is-active", svc]
                is_active = subprocess.check_output(cmd, stderr=subprocess.STDOUT).decode().strip() == "active"
                state["active"] = is_active
                if is_active and state["default_port"] > 0:
                    try:
                        pid = int(subprocess.check_output(["systemctl", "--user", "show", "-p", "MainPID", "--value", svc], timeout=1).strip())
                        if pid > 0:
                            proc = psutil.Process(pid)
                            pids = [p.pid for p in proc.children(recursive=True)] + [pid]
                            found_port = state["default_port"]
                            for conn in psutil.net_connections(kind="tcp"):
                                if conn.status == "LISTEN" and conn.pid in pids:
                                    found_port = conn.laddr.port; break
                            state["port"] = found_port
                    except: pass
                else: state["port"] = state["default_port"]
            except: state["active"] = False
        time.sleep(2.0)

def gpu_worker():
    global GPU_INFO, IS_RUNNING
    while IS_RUNNING:
        try:
            cmd = ["nvidia-smi", "--query-gpu=utilization.gpu,memory.used,memory.total,temperature.gpu,clocks_throttle_reasons.active,clocks.gr,power.draw,pcie.link.gen.current,pcie.link.width.current,pstate", "--format=csv,noheader,nounits"]
            output = subprocess.check_output(cmd, timeout=2).decode().strip()
            parts = output.split(", ")
            util, mem_used, mem_total, temp, throttle, clk_gr, pwr, p_gen, p_wid, pstate = parts
            u_p = (int(mem_used) / int(mem_total)) * 100
            reason = ""; is_alert = False; is_active = pstate.strip() in ["P0", "P1", "P2", "P3"]
            if "0x" in throttle and throttle != "0x0000000000000000" and "Not Active" not in throttle:
                if any(x in throttle for x in ["Thermal", "0x0000000000000008"]): reason = "THERMAL"; is_alert = True
                elif any(x in throttle for x in ["Power", "0x0000000000000004"]): reason = "POWER"; is_alert = True
                elif not is_active: reason = "IDLE"; is_alert = False
            mhz = float(clk_gr)
            if mhz > 1950: boost = "OC!"; b_color = C_PURPLE
            elif mhz > 1560: boost = "BST"; b_color = C_CYAN
            else: boost = "REG"; b_color = C_ORANGE
            try:
                comp_out = subprocess.check_output(["nvidia-smi", "--query-compute-apps=used_memory", "--format=csv,noheader,nounits"], timeout=1).decode().strip()
                comp_vram = sum([int(x) for x in comp_out.splitlines() if x.isdigit()])
            except: comp_vram = 0
            sys_vram = max(0, int(mem_used) - comp_vram)
            GPU_INFO = {"util": int(util), "used": mem_used, "total": mem_total, "temp": temp, "mem_percent": u_p, "reason": reason, "is_alert": is_alert, "mhz": mhz, "boost": boost, "boost_color": b_color, "pwr": float(pwr), "pcie": f"PCIe {p_gen}.0 x{p_wid}", "comp_v": comp_vram, "sys_v": sys_vram}
        except: GPU_INFO = None
        time.sleep(1.0)

def log_worker():
    global LOG_HISTORY, JOURNAL_HISTORY, LAST_LOG_SERVICE, LAST_LOG_MINUTE, LAST_JRN_SERVICE, LAST_JRN_MINUTE, IS_RUNNING
    services = {
        "comfyui.service": ("COMFYUI", C_CYAN), 
        "sd-webui.service": ("WEBUI", C_GREEN), 
        "ollama.service": ("OLLAMA", C_ORANGE),
        "hermes-agent.service": ("HERMS", C_PURPLE)
    }
    proc = subprocess.Popen(["journalctl", "--user", "-f", "-n", "50", "-o", "json"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    while IS_RUNNING:
        line = proc.stdout.readline()
        if not line:
            time.sleep(0.1); continue
        try: data = json.loads(line)
        except: continue
        unit_name = data.get("_SYSTEMD_USER_UNIT") or data.get("USER_UNIT", "")
        msg = data.get("MESSAGE", "")
        if isinstance(msg, list):
            try: msg = "".join(chr(x) for x in msg)
            except: msg = str(msg)
        if not msg: continue
        
        label = ""; color = C_WHITE; is_journal = False
        
        if unit_name in services:
            label, base_color = services[unit_name]
            msg = re.sub(r'\[GIN\].*?\||time=".*?"\s+level=.*?\s+msg=', '', msg).strip()
            if label == "OLLAMA":
                m_match = re.search(r'msg="([^"]+)"', msg)
                if m_match: msg = m_match.group(1)
            # Ignore general noise, but keep API calls for AI/Agents
            if any(x in msg for x in ["%|", "it/s", "tk/s"]) or (msg.strip().isdigit() and len(msg) < 5): continue
            if any(x in msg for x in ["200 OK", "304 Not"]): continue

            # Allow Hermes/Ollama API traffic narration
            # but still block noisy repeated polls if they become a burden
            msg_color = C_RED if any(x in msg.lower() for x in ["error", "fail", "exception"]) else C_WHITE
            formatted = f"{base_color}●{C_RESET} {msg_color}{msg[:100]}{C_RESET}"
            is_journal = False
        else:
            label = data.get("SYSLOG_IDENTIFIER", "OS")
            color = C_GREY; is_journal = True
            noise = ["preloaded using link preload", "appropriate `as` value", "mon-ai-state.json", "Brave Search"]
            if any(x in msg for x in noise): continue

            # Pass systemctl and other OS events, but block generic web logs for OS services
            if any(x in msg for x in ["GET /", "POST /", "200 OK", "304 Not"]): continue
            formatted = f"{C_GREY}●{C_RESET} {msg[:100]}"

        try:
            ts_us = int(data.get("__REALTIME_TIMESTAMP", 0))
            now = datetime.fromtimestamp(ts_us / 1000000.0)
        except: now = datetime.now()
        curr_sec = now.strftime('%H:%M:%S'); curr_min = now.strftime('%H:%M')

        if is_journal:
            if label != LAST_JRN_SERVICE or curr_min != LAST_JRN_MINUTE:
                JOURNAL_HISTORY.append(f"{C_BOLD}{C_PURPLE}[{label[:12]}]{C_RESET} {C_GREY}{now.strftime('%d/%m')} {curr_sec}{C_RESET}")
                LAST_JRN_SERVICE = label; LAST_JRN_MINUTE = curr_min
            if not JOURNAL_HISTORY or formatted != JOURNAL_HISTORY[-1]: JOURNAL_HISTORY.append(formatted)
            if len(JOURNAL_HISTORY) > 200: JOURNAL_HISTORY.pop(0)
        else:
            if label != LAST_LOG_SERVICE or curr_min != LAST_LOG_MINUTE:
                LOG_HISTORY.append(f"{C_BOLD}{base_color}[{label}]{C_RESET} {C_GREY}{now.strftime('%d/%m')} {curr_sec}{C_RESET}")
                LAST_LOG_SERVICE = label; LAST_LOG_MINUTE = curr_min
            if not LOG_HISTORY or formatted != LOG_HISTORY[-1]: LOG_HISTORY.append(formatted)
            if len(LOG_HISTORY) > 200: LOG_HISTORY.pop(0)
    proc.terminate()

