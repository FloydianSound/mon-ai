#!/bin/bash

SERVICES=("comfyui" "sd-webui" "ollama")

echo -e "\033[1;34mStarting AI Stack...\033[0m"

for svc in "${SERVICES[@]}"; do
    echo -e "Starting \033[1;36m$svc\033[0m..."
    systemctl --user start "$svc"
done

echo -e "\033[1;32mStack started successfully.\033[0m"
echo -e "Monitor available at: \033[1;35mcomfy-mon\033[0m"
