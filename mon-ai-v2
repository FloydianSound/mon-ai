# --- HARDWARE DETECTION ---

def get_hw_names():
    cpu_name = "CPU"; gpu_name = "GPU"; disk_name = "NVME STORAGE"
    try:
        with open("/proc/cpuinfo", "r") as f:
            for line in f:
                if "model name" in line:
                    cpu_name = line.split(":")[1].strip()
                    cpu_name = re.sub(r'\(R\)|\(TM\)|Processor|Core', '', cpu_name).strip()
                    break
        gpu_out = subprocess.check_output(["nvidia-smi", "--query-gpu=name", "--format=csv,noheader"]).decode().strip()
        gpu_name = gpu_out.replace("NVIDIA ", "").strip()
        disk_out = subprocess.check_output("lsblk -dno MODEL /dev/nvme0n1", shell=True).decode().strip()
        if disk_out: disk_name = disk_out
    except: pass
    return cpu_name[:25], gpu_name[:25], disk_name[:20]

def find_cpu_sensors():
    global CPU_HW_PATHS
    try:
        hwmons = os.listdir("/sys/class/hwmon")
        for hw in hwmons:
            name = open(f"/sys/class/hwmon/{hw}/name").read().strip()
            if name == "coretemp":
                CPU_HW_PATHS["tmp"] = f"/sys/class/hwmon/{hw}/temp1_input"; break
    except: pass
    rapl_path = "/sys/class/powercap/intel-rapl:0/energy_uj"
    if os.path.exists(rapl_path):
        CPU_HW_PATHS["pwr"] = rapl_path

# --- BACKGROUND THREADS ---

def disk_worker():
    global IS_RUNNING, HOME_RATIO
    # First-pass immediate scan
    try:
        home_b = int(subprocess.check_output("du -sb /home 2>/dev/null", shell=True, timeout=60).decode().split()[0])
        total_used_b = psutil.disk_usage('/').used
        if total_used_b > 0: HOME_RATIO = home_b / total_used_b
    except: pass
    
    while IS_RUNNING:
        for _ in range(600):
            if not IS_RUNNING: break
            time.sleep(1)
        try:
            home_b = int(subprocess.check_output("du -sb /home 2>/dev/null", shell=True, timeout=60).decode().split()[0])
            total_used_b = psutil.disk_usage('/').used
            if total_used_b > 0: HOME_RATIO = home_b / total_used_b
        except: pass

def service_worker():
    global IS_RUNNING, SERVICE_STATES
    while IS_RUNNING:
        for svc, state in SERVICE_STATES.items():
            try:
                cmd = ["systemctl", "--user", "is-active", svc]
                is_active = subprocess.check_output(cmd, stderr=subprocess.STDOUT).decode().strip() == "active"
                state["active"] = is_active
                if is_active:
                    try:
                        pid = int(subprocess.check_output(["systemctl", "--user", "show", "-p", "MainPID", "--value", svc], timeout=1).strip())
                        if pid > 0:
                            proc = psutil.Process(pid)
                            pids = [p.pid for p in proc.children(recursive=True)] + [pid]
                            found_port = state["default_port"]
                            for conn in psutil.net_connections(kind="tcp"):
                                if conn.status == "LISTEN" and conn.pid in pids:
                                    found_port = conn.laddr.port; break
                            state["port"] = found_port
                    except: pass
                else: state["port"] = state["default_port"]
            except: state["active"] = False
        time.sleep(1.0)

def gpu_worker():
    global GPU_INFO, IS_RUNNING
    while IS_RUNNING:
        try:
            cmd = ["nvidia-smi", "--query-gpu=utilization.gpu,memory.used,memory.total,temperature.gpu,clocks_throttle_reasons.active,clocks.gr,power.draw,pcie.link.gen.current,pcie.link.width.current,pstate", "--format=csv,noheader,nounits"]
            output = subprocess.check_output(cmd, timeout=2).decode().strip()
            parts = output.split(", ")
            util, mem_used, mem_total, temp, throttle, clk_gr, pwr, p_gen, p_wid, pstate = parts
            u_p = (int(mem_used) / int(mem_total)) * 100
            reason = ""; is_alert = False; is_active = pstate.strip() in ["P0", "P1", "P2", "P3"]
            if "0x" in throttle and throttle != "0x0000000000000000" and "Not Active" not in throttle:
                if any(x in throttle for x in ["Thermal", "0x0000000000000008"]): reason = "THERMAL"; is_alert = True
                elif any(x in throttle for x in ["Power", "0x0000000000000004"]): reason = "POWER"; is_alert = True
                elif not is_active: reason = "IDLE"; is_alert = False
            mhz = float(clk_gr)
            if mhz > 1950: boost = "OC!"; b_color = C_PURPLE
            elif mhz > 1560: boost = "BST"; b_color = C_CYAN
            else: boost = "REG"; b_color = C_ORANGE

            try:
                comp_out = subprocess.check_output(["nvidia-smi", "--query-compute-apps=used_memory", "--format=csv,noheader,nounits"], timeout=1).decode().strip()
                comp_vram = sum([int(x) for x in comp_out.splitlines() if x.isdigit()])
            except: comp_vram = 0
            
            sys_vram = max(0, int(mem_used) - comp_vram)
            GPU_INFO = {"util": int(util), "used": mem_used, "total": mem_total, "temp": temp, "mem_percent": u_p, "reason": reason, "is_alert": is_alert, "mhz": mhz, "boost": boost, "boost_color": b_color, "pwr": float(pwr), "pcie": f"PCIe {p_gen}.0 x{p_wid}", "comp_v": comp_vram, "sys_v": sys_vram}
        except: GPU_INFO = None
        time.sleep(1.0)

def log_worker():
    global LOG_HISTORY, LAST_LOG_SERVICE, LAST_LOG_MINUTE, IS_RUNNING, SERVICE_SPEEDS
    services = {"comfyui.service": ("COMFYUI", C_CYAN, 0), "sd-webui.service": ("WEBUI", C_GREEN, 1), "ollama.service": ("OLLAMA", C_ORANGE, 2)}
    keywords = ["it/s", "tk/s", "token", "error", "exception", "loaded", "loading", "prompt", "inference", "starting", "started", "stopped", "stopping", "success", "failed", "queue", "server", "version", "gui"]
    
    proc = subprocess.Popen(["journalctl", "--user", "-f", "-n", "50", "-o", "json"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, text=True)
    
    while IS_RUNNING:
        line = proc.stdout.readline()
        if not line:
            time.sleep(0.1); continue
        try: data = json.loads(line)
        except: continue
        
        unit_name = data.get("_SYSTEMD_USER_UNIT") or data.get("USER_UNIT", "")
        msg = data.get("MESSAGE", "")
        if type(msg) is not str: msg = str(msg)
        if not msg: continue
        
        label = ""; color = C_WHITE; idx = -1
        if unit_name in services: label, color, idx = services[unit_name]
        elif data.get("SYSLOG_IDENTIFIER") == "systemd": label = "SYSTEMD"; color = C_PURPLE
        elif any(k in msg.lower() for k in keywords): label = "JOURNAL"; color = C_GREY
        
        if not label: continue

        if label == "OLLAMA" and data.get("SYSLOG_IDENTIFIER") != "systemd":
            m_match = re.search(r'msg="([^"]+)"', msg)
            if m_match:
                clean_msg = m_match.group(1); tail = re.sub(r'^.*?msg="[^"]+"\s*', '', msg).strip()
                if tail:
                    tail = re.sub(r'([a-zA-Z0-9_]+)=("[^"]*"|\S+)', f'{C_CYAN}\\1{C_RESET}={C_GREEN}\\2{C_RESET}', tail)
                    msg = f"{clean_msg} {tail}"
                else: msg = clean_msg
                
        if idx != -1:
            if unit_name == "comfyui.service":
                m = re.findall(r"([0-9.]+)it/s", msg)
                if m: SERVICE_SPEEDS[idx] = f"{m[-1]} it/s"
            elif unit_name == "sd-webui.service":
                m = re.findall(r"(\d+\.\d+)it/s", msg)
                if m: SERVICE_SPEEDS[idx] = f"{m[-1]} it/s"
            elif unit_name == "ollama.service":
                m = re.findall(r"eval rate:\s+([0-9.]+)\s+tokens/s", msg)
                if m: SERVICE_SPEEDS[idx] = f"{m[-1]} tk/s"
                else:
                    gm = re.findall(r"\| ([0-9.]+)s \|", msg)
                    if gm: SERVICE_SPEEDS[idx] = f"Lat: {gm[-1]}s"

        if not any(k in msg.lower() for k in keywords) and label == "JOURNAL": continue
        if any(x in msg for x in ["GET /", "POST /", "200 OK", "304 Not"]): continue
        
        try:
            ts_us = int(data.get("__REALTIME_TIMESTAMP", 0))
            now = datetime.fromtimestamp(ts_us / 1000000.0)
        except: now = datetime.now()
            
        curr_sec = now.strftime('%H:%M:%S'); curr_min = now.strftime('%H:%M')
        formatted = f"{color}●{C_RESET} {C_RED if 'ERR' in msg.upper() else (C_ORANGE if 'it/s' in msg else C_WHITE)}{msg[:100]}{C_RESET}"
        
        if label != LAST_LOG_SERVICE or curr_min != LAST_LOG_MINUTE:
            LOG_HISTORY.append(f"{C_BOLD}{color}[{label}]{C_RESET} {C_GREY}{now.strftime('%d/%m')} {curr_sec}{C_RESET}")
            LAST_LOG_SERVICE = label; LAST_LOG_MINUTE = curr_min
            
        if not LOG_HISTORY or formatted != LOG_HISTORY[-1]:
            LOG_HISTORY.append(formatted)
        if len(LOG_HISTORY) > 200: LOG_HISTORY.pop(0)
    proc.terminate()

