def load_state():
    global TOTAL_WH, TOTAL_COST, TOTAL_CO2, HOME_RATIO
    try:
        if os.path.exists(STATE_FILE):
            with open(STATE_FILE, "r") as f:
                data = json.load(f)
                TOTAL_WH = data.get("total_wh", 0.0); TOTAL_COST = data.get("total_cost", 0.0); TOTAL_CO2 = data.get("total_co2", 0.0)
                HOME_RATIO = data.get("home_ratio", 0.5)
    except: pass

def save_state():
    try:
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        with open(STATE_FILE, "w") as f:
            json.dump({"total_wh": TOTAL_WH, "total_cost": TOTAL_COST, "total_co2": TOTAL_CO2, "home_ratio": HOME_RATIO}, f)
    except: pass

def get_psu_efficiency(dc_watts):
    load_p = (dc_watts / 1500.0) * 100
    if load_p < 2: return 0.70
    if load_p < 5: return 0.85
    if load_p < 10: return 0.91
    if load_p < 20: return 0.94
    if load_p < 50: return 0.96
    return 0.94

def get_fan_power(cpu_temp):
    try:
        t = float(cpu_temp)
        if t <= 40: pwm = 0.2
        elif t >= 75: pwm = 1.0
        else: pwm = 0.2 + (0.8 * (t - 40) / 35.0)
        return 5.0 + (49.0 * (pwm ** 2.5))
    except: return 15.0

def get_airflow_stats(cpu_temp):
    try:
        t = float(cpu_temp)
        if t <= 40: pwm = 0.2
        elif t >= 75: pwm = 1.0
        else: pwm = 0.2 + (0.8 * (t - 40) / 35.0)
        in_cfm = (2 * 143.2) * pwm
        ex_cfm = (223.4 * pwm) + (2 * 82.7 * (pwm * 0.5))
        bal = in_cfm - ex_cfm
        state = f"{C_GREEN}POS{C_RESET}" if bal > 5 else (f"{C_RED}NEG{C_RESET}" if bal < -5 else f"{C_CYAN}NEU{C_RESET}")
        gauge_w = 10; val = max(-100, min(100, bal)); pos = int((val + 100) / 200 * gauge_w)
        gauge = f"{C_GREY}[{C_RESET}{C_CYAN}{'·' * pos}{C_ORANGE}⟛{C_RESET}{C_CYAN}{'·' * (gauge_w - pos)}{C_GREY}]{C_RESET}"
        return {"in": in_cfm, "ex": ex_cfm, "bal": bal, "state": state, "gauge": gauge}
    except: return None

