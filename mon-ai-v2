def is_port_open(port):
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.05)
        try: return s.connect_ex(('127.0.0.1', port)) == 0
        except: return False

def set_status(msg):
    global LAST_CMD, CMD_EXPIRE
    clean_msg = re.sub(r'\x1B(?:[@-Z\\-_]|\[[0-?]*[ -/]*[@-~])', '', str(msg))
    LAST_CMD = clean_msg.replace('\n', ' ').strip(); CMD_EXPIRE = time.time() + 5.0

def run_captured(cmd_list):
    try:
        res = subprocess.run(cmd_list, capture_output=True, text=True, timeout=10)
        out = res.stdout.strip() or res.stderr.strip()
        if out: set_status(out.splitlines()[-1])
        else: set_status("COMMAND EXECUTED SUCCESSFULLY")
    except Exception as e: set_status(f"ERROR: {str(e)}")

def get_temp_color(temp_str):
    try:
        t = float(re.findall(r"([0-9.]+)", str(temp_str))[0])
        if t < 45: return C_BLUE
        if t < 65: return C_GREEN
        if t < 80: return C_YELLOW
        return C_RED
    except: return C_WHITE

def toggle_service(service_name, label):
    is_on = SERVICE_STATES[service_name]["active"]; action = "stop" if is_on else "start"
    set_status(f"{'STOPPING' if is_on else 'STARTING'} {label.upper()}...")
    run_captured(["systemctl", "--user", action, service_name])

def get_cpu_info():
    global LAST_CPU_E, LAST_CPU_T, CPU_HW_PATHS
    try:
        util = psutil.cpu_percent(interval=None)
        load = os.getloadavg()
        try: ghz = psutil.cpu_freq().current / 1000.0
        except: ghz = 0.0
        watts = 0.0
        if CPU_HW_PATHS["pwr"]:
            try:
                curr_e = int(open(CPU_HW_PATHS["pwr"]).read()); curr_t = time.time()
                if LAST_CPU_E > 0: watts = (curr_e - LAST_CPU_E) / 1000000 / (curr_t - LAST_CPU_T)
                LAST_CPU_E = curr_e; LAST_CPU_T = curr_t
            except: pass
        p_disp = f"{watts:.1f}W" if watts > 0 else "N/A"
        is_active = util > 10.0
        if ghz > 5.6: boost = "OC!"; b_color = C_PURPLE
        elif ghz > 3.2: boost = "BST"; b_color = C_CYAN
        else: boost = "REG"; b_color = C_ORANGE
        temp = "N/A"
        if CPU_HW_PATHS["tmp"]:
            try: temp = int(open(CPU_HW_PATHS["tmp"]).read()) / 1000
            except: pass
        reason = ""; is_alert = False
        try:
            t_v = float(temp)
            if t_v >= 98: reason = "THERMAL"; is_alert = True
            elif watts >= 350: reason = "POWER"; is_alert = True
            elif not is_active and util < 5.0: reason = "IDLE"; is_alert = False
        except: pass
        return {"util": util, "load": load, "temp": temp, "ghz": ghz, "boost": boost, "boost_color": b_color, "reason": reason, "is_alert": is_alert, "pwr": p_disp, "bus": "DMI 4.0 x8"}
    except: return None

def get_zram_info():
    try:
        def to_mb(s):
            units = {"G": 1024, "M": 1, "K": 1/1024, "B": 1/(1024*1024)}
            if s[-1].upper() in units: return float(s[:-1]) * units[s[-1].upper()]
            return float(s)
        out = subprocess.check_output("zramctl --raw --noheadings -o DISKSIZE,DATA,COMPR,TOTAL", shell=True).decode().split()
        if len(out) >= 4:
            disk = to_mb(out[0]); logical = to_mb(out[1]); compr = to_mb(out[2]); physical = to_mb(out[3])
            ratio = logical / compr if compr > 0 else 1.0
            return {"used": logical, "total": disk, "percent": (logical/disk)*100 if disk else 0, "compr": compr, "phys": physical, "ratio": ratio}
    except: pass
    return None

def update_energy(cpu_pwr, gpu_pwr, it_speeds, cpu_temp):
    global SESSION_WH, SESSION_COST, LAST_UPDATE, PEAK_W, TOTAL_WH, TOTAL_COST, TOTAL_CO2, PREV_W, PREV_EFF, PREV_M_PEAK, PEAK_HISTORY
    now = time.time(); dt = now - LAST_UPDATE; LAST_UPDATE = now
    try: c_w = float(str(cpu_pwr).replace("W", ""))
    except: c_w = 0.0
    fan_w = get_fan_power(cpu_temp)
    internal_dc_w = c_w + (gpu_pwr or 0) + 70.0 + fan_w
    eff_f = get_psu_efficiency(internal_dc_w)
    total_w = internal_dc_w / eff_f
    
    PEAK_HISTORY.append((now, total_w))
    PEAK_HISTORY = [x for x in PEAK_HISTORY if now - x[0] <= 60]
    m_peak = max([x[1] for x in PEAK_HISTORY]) if PEAK_HISTORY else total_w
    p_t = "↑" if m_peak > PREV_M_PEAK + 0.1 else ("↓" if m_peak < PREV_M_PEAK - 0.1 else " ")
    PREV_M_PEAK = m_peak
    if total_w > PEAK_W: PEAK_W = total_w
    w_t = "↑" if total_w > PREV_W + 2 else ("↓" if total_w < PREV_W - 2 else " ")
    PREV_W = total_w

    wh = (total_w * dt) / 3600; SESSION_WH += wh; TOTAL_WH += wh
    rate = 0.091; cost = (wh / 1000) * rate; SESSION_COST += cost; TOTAL_COST += cost
    TOTAL_CO2 += (wh / 1000) * 475.0
    if int(now) % 30 == 0: save_state()
    
    global BEST_EFF
    eff = 0.0
    try:
        total_it = sum([float(re.findall(r"([0-9.]+)", str(s))[0]) for s in it_speeds if "it/s" in str(s) or "tk/s" in str(s)])
        if total_w > 150:
            eff = total_it / total_w
            if eff > BEST_EFF: BEST_EFF = eff
    except: pass
    e_t = "↑" if eff > PREV_EFF + 0.0001 else ("↓" if eff < PREV_EFF - 0.0001 else " ")
    PREV_EFF = eff

    try:
        remaining = 1.0 - (SESSION_COST % 1.0); burn_rate = (total_w / 1000.0) * rate 
        next_dollar_h = remaining / burn_rate if burn_rate > 0 else 0
    except: next_dollar_h = 0
    
    elapsed = (now - START_TIME) / 3600
    if elapsed > 0.001:
        avg_w = SESSION_WH / elapsed; d_kwh = (avg_w * 24) / 1000; d_cost = d_kwh * rate; m_kwh = d_kwh * 30; m_cost = m_kwh * rate
    else: d_kwh = d_cost = m_kwh = m_cost = 0.0
    return {"total_w": total_w, "peak_w": PEAK_W, "m_peak": m_peak, "m_kwh": m_kwh, "m_cost": m_cost, "d_cost": d_cost, "eff": eff, "next_d": next_dollar_h, "amps": total_w/120.0, "w_t": w_t, "e_t": e_t, "p_t": p_t}

def buf_move(y, x): return f"\033[{y};{x}H"
def draw_frame(y, x, w, h, title=""):
    out = buf_move(y, x) + f"{C_CYAN}┌{'─' * (w-2)}┐{C_RESET}"
    for i in range(1, h-1): out += buf_move(y+i, x) + f"\033[K"
    out += buf_move(y+h-1, x) + f"{C_CYAN}└{'─' * (w-2)}┘{C_RESET}"
    if title: out += buf_move(y, x+2) + f"{C_BOLD}{C_CYAN} {title} {C_RESET}"
    return out

def draw_bar(y, x, w, percent, color, label, suffix="", boost="", b_color=C_CYAN):
    bar_w = w - 18
    if bar_w < 5: bar_w = 5
    filled = max(0, min(bar_w, int(percent / 100 * bar_w)))
    bar = f"{color}{'█' * filled}{C_RESET}{C_GREY}{'░' * (bar_w - filled)}{C_RESET}"
    return buf_move(y, x) + f"\033[K{label:5} {bar} {C_BOLD}{suffix:>6}{C_RESET} {C_BOLD}{b_color}{boost:>3}{C_RESET}"

def draw_stacked_bar(y, x, w, segments, label, suffix=""):
    bar_w = w - 18
    if bar_w < 5: bar_w = 5
    fills = []; total_fill = 0
    for p, _ in segments:
        f = int(max(0, p) / 100 * bar_w)
        if p > 0 and f == 0: f = 1
        fills.append(f); total_fill += f
    while total_fill > bar_w:
        idx = fills.index(max(fills)); fills[idx] -= 1; total_fill -= 1
    bar = ""
    for i, f in enumerate(fills):
        if f > 0: bar += f"{segments[i][1]}{'█' * f}{C_RESET}"
    bar += f"{C_GREY}{'░' * max(0, bar_w - total_fill)}{C_RESET}"
    return buf_move(y, x) + f"\033[K{label:5} {bar} {C_BOLD}{suffix:>6}{C_RESET}    "

def main():
    global LOG_HISTORY, POLL_IDX, POLL_RATE, IS_RUNNING
    load_state(); find_cpu_sensors()
    old_settings = termios.tcgetattr(sys.stdin)
    hostname = platform.node(); kernel = platform.release(); c_name, g_name, d_name = get_hw_names()
    psutil.cpu_percent(interval=None) 
    
    t_dsk = threading.Thread(target=disk_worker, daemon=True); t_srv = threading.Thread(target=service_worker, daemon=True)
